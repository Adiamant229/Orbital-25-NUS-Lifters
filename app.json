{
  "expo": {
    "scheme": "nus-lifters",
    "name": "nus-lifters",
    "slug": "nus-lifters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/NUS_Lifters1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img/NUS_Lifters1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/NUS_Lifters1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.NUSLifters"
    },
    "web": {
      "favicon": "./assets/img/NUS_Lifters1.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86de6634-a536-400a-a782-9914137cf57c"
      }
    }
  }
}
